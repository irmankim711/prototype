# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

# Force the following filetypes to have unix eols, since they are development files
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.gitignore text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Configuration files that should have LF endings
*.conf text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
requirements*.txt text eol=lf

# Force the following filetypes to have windows eols (if any)
*.bat text eol=crlf
*.cmd text eol=crlf

# Declare files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.tar binary
*.gz binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Specific to your application - database files should remain binary
*.db binary
instance/*.db binary

# Generated files that should not be touched
node_modules/* binary
.venv/* binary
__pycache__/* binary
*.pyc binary
.git/* binary