# ========================================
# PRODUCTION FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================
# IMPORTANT: Copy this file to .env.production and fill in your actual values
# Frontend env vars are embedded in the build, so they are public
# DO NOT put sensitive secrets here (API keys, passwords, etc.)
# ========================================

# ========================================
# ENVIRONMENT
# ========================================
VITE_ENVIRONMENT=production
VITE_NODE_ENV=production

# ========================================
# BACKEND API CONFIGURATION
# ========================================
# CRITICAL: Set your actual production backend URL!
VITE_API_BASE_URL=https://api.your-production-domain.com/api
VITE_BACKEND_URL=https://api.your-production-domain.com
VITE_API_TIMEOUT=30000
VITE_MAX_RETRY_ATTEMPTS=3
VITE_RETRY_DELAY=1000
VITE_MAX_RETRY_DELAY=10000

# ========================================
# FIREBASE CONFIGURATION
# ========================================
# Get these from: https://console.firebase.google.com/project/report-automation-57f6e/settings/general
# NOTE: These are safe to expose in frontend code (they're public)
VITE_FIREBASE_API_KEY=AIzaSyCGpr8w2sPsngexBYBg6ktNE64IWENtD2Q
VITE_FIREBASE_AUTH_DOMAIN=report-automation-57f6e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=report-automation-57f6e
VITE_FIREBASE_STORAGE_BUCKET=report-automation-57f6e.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=87279819935
VITE_FIREBASE_APP_ID=1:87279819935:web:9f78b1c4c2efe16ad4d6aa
VITE_FIREBASE_MEASUREMENT_ID=G-R2HGN102D3

# Firebase Development Settings
VITE_FIREBASE_USE_EMULATOR=false

# ========================================
# FIREBASE APP CHECK
# ========================================
# Get your reCAPTCHA v3 site key from: https://www.google.com/recaptcha/admin
# Enable App Check in Firebase Console
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
VITE_APP_CHECK_ENABLED=true
# For production, do NOT use debug tokens
VITE_APP_CHECK_DEBUG_TOKEN=

# ========================================
# OAUTH CONFIGURATION
# ========================================
# Google OAuth Client ID (public, safe to expose)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Microsoft OAuth Client ID (public, safe to expose)
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id

# ========================================
# APPLICATION CONFIGURATION
# ========================================
VITE_APP_NAME=Automated Report Platform
VITE_APP_VERSION=1.0.0

# ========================================
# FEATURE FLAGS
# ========================================
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=true
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_AUTH_BYPASS=false
VITE_ENABLE_DEV_TOOLS=false
VITE_SHOW_PERFORMANCE_OVERLAY=false

# ========================================
# DEVELOPMENT AUTHENTICATION (DISABLED IN PRODUCTION)
# ========================================
# These should be disabled in production
VITE_DEV_USER_ID=
VITE_DEV_USER_EMAIL=
VITE_DEV_USER_ROLE=

# ========================================
# EXTERNAL SERVICES (OPTIONAL)
# ========================================
# Sentry for error tracking (optional but recommended)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=G-YOUR-TRACKING-ID
# Mixpanel (if using)
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# ========================================
# SECURITY SETTINGS
# ========================================
VITE_ENABLE_HTTPS_ONLY=true
VITE_ENABLE_CONTENT_SECURITY_POLICY=true
VITE_ENABLE_HSTS=true
VITE_ENABLE_HOT_RELOAD=false
VITE_ENABLE_SOURCE_MAPS=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
