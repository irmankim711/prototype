# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================
# IMPORTANT: Copy this file to .env.production and fill in your actual values
# DO NOT commit .env.production with real secrets to version control
# ========================================

# ========================================
# APPLICATION CONFIGURATION
# ========================================
FLASK_ENV=production
DEBUG=false
TESTING=false
APP_NAME=Automated Report Platform
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=5000

# ========================================
# SECURITY CONFIGURATION
# ========================================
# CRITICAL: Generate strong secrets for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION
JWT_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_SECURE_RANDOM_STRING
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
PASSWORD_HASH_ROUNDS=12
ENCRYPTION_KEY=CHANGE_THIS_TO_YET_ANOTHER_SECURE_KEY

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Production PostgreSQL database
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@your-database-host.com:5432/production_db
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ========================================
# REDIS CONFIGURATION
# ========================================
# Redis for caching, sessions, and Celery
REDIS_URL=redis://your-redis-host.com:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# Rate limiting Redis (separate DB)
RATELIMIT_STORAGE_URL=redis://your-redis-host.com:6379/1
RATELIMIT_DEFAULT=200 per day; 50 per hour

# ========================================
# CORS CONFIGURATION
# ========================================
# CRITICAL: Set your actual production frontend URLs!
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=3600

# ========================================
# GOOGLE OAUTH & APIS CONFIGURATION
# ========================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-production-domain.com/api/google-forms/callback

# ========================================
# FIREBASE CONFIGURATION
# ========================================
# Get these from: https://console.firebase.google.com/project/report-automation-57f6e/settings/general
FIREBASE_API_KEY=AIzaSyCGpr8w2sPsngexBYBg6ktNE64IWENtD2Q
FIREBASE_AUTH_DOMAIN=report-automation-57f6e.firebaseapp.com
FIREBASE_PROJECT_ID=report-automation-57f6e
FIREBASE_STORAGE_BUCKET=report-automation-57f6e.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=87279819935
FIREBASE_APP_ID=1:87279819935:web:9f78b1c4c2efe16ad4d6aa
FIREBASE_MEASUREMENT_ID=G-R2HGN102D3

# Firebase Service Account (for backend)
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# ========================================
# MICROSOFT OAUTH (OPTIONAL)
# ========================================
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_REDIRECT_URI=https://your-production-domain.com/api/microsoft/callback

# ========================================
# AI SERVICES (OPTIONAL)
# ========================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
GEMINI_API_KEY=your-gemini-api-key

# ========================================
# CELERY CONFIGURATION (OPTIONAL)
# ========================================
CELERY_BROKER_URL=redis://your-redis-host.com:6379/0
CELERY_RESULT_BACKEND=redis://your-redis-host.com:6379/0
CELERY_TIMEZONE=UTC

# ========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@your-production-domain.com

# ========================================
# MONITORING & LOGGING
# ========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=WARNING
ENABLE_METRICS=true

# ========================================
# SESSION & SECURITY
# ========================================
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
FORCE_HTTPS=true
