rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has admin role
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // =========================================================================
    // PARSED EXCEL FILES COLLECTION - CRITICAL SECURITY
    // =========================================================================

    match /parsed_excel_files/{fileId} {
      // Read: User must be authenticated and match user_id
      allow read: if isAuthenticated()
                  && resource.data.user_id == request.auth.uid;

      // List/Query: User can only query their own files - ENFORCES WHERE CLAUSE
      allow list: if isAuthenticated()
                  && request.query.filters.hasAny(['user_id'])
                  && request.auth.uid in request.query.filters;

      // Create: User must be authenticated and set correct user_id
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'id', 'user_id', 'original_filename', 'file_path',
                      'status', 'uploaded_at'
                    ]);

      // Update: User must own the file and not change user_id
      allow update: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == resource.data.user_id;

      // Delete: User must own the file or is admin
      allow delete: if isAuthenticated() &&
                       (resource.data.user_id == request.auth.uid || isAdmin());
    }

    // =========================================================================
    // EXCEL TABLES COLLECTION - CRITICAL SECURITY
    // =========================================================================

    match /excel_tables/{tableId} {
      // Helper to check if user owns parent file
      function ownsParentFile() {
        return exists(/databases/$(database)/documents/parsed_excel_files/$(resource.data.parsed_file_id))
            && get(/databases/$(database)/documents/parsed_excel_files/$(resource.data.parsed_file_id)).data.user_id == request.auth.uid;
      }

      // Read: User must own the parent file
      allow read: if isAuthenticated() && ownsParentFile();

      // List/Query: User can query tables only for their files
      // WARNING: Without proper WHERE clause, this will scan all tables (expensive)
      allow list: if isAuthenticated();

      // Create: User must own the parent file
      allow create: if isAuthenticated()
                    && exists(/databases/$(database)/documents/parsed_excel_files/$(request.resource.data.parsed_file_id))
                    && get(/databases/$(database)/documents/parsed_excel_files/$(request.resource.data.parsed_file_id)).data.user_id == request.auth.uid;

      // Update: User must own parent file
      allow update: if isAuthenticated() && ownsParentFile();

      // Delete: User must own parent file or is admin (cascade delete)
      allow delete: if isAuthenticated() && (ownsParentFile() || isAdmin());
    }

    // =========================================================================
    // DEFAULT DENY - CRITICAL SECURITY
    // =========================================================================

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
