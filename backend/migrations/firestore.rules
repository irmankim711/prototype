rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns a resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ParsedExcelFiles collection - user can only access their own files
    match /parsed_excel_files/{fileId} {
      // Read: User must be authenticated and match user_id
      allow read: if isAuthenticated()
                  && resource.data.user_id == request.auth.uid;

      // List/Query: User can only query their own files
      allow list: if isAuthenticated()
                  && request.query.filters.hasAny(['user_id'])
                  && request.auth.uid in request.query.filters;

      // Create: User must be authenticated and set correct user_id
      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'id', 'user_id', 'original_filename', 'file_path',
                      'status', 'uploaded_at'
                    ]);

      // Update: User must own the file and not change user_id
      allow update: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == resource.data.user_id;

      // Delete: User must own the file
      allow delete: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid;
    }

    // ExcelTables collection - user can access if they own the parent file
    match /excel_tables/{tableId} {
      // Helper to check if user owns parent file
      function ownsParentFile() {
        return exists(/databases/$(database)/documents/parsed_excel_files/$(resource.data.parsed_file_id))
            && get(/databases/$(database)/documents/parsed_excel_files/$(resource.data.parsed_file_id)).data.user_id == request.auth.uid;
      }

      // Read: User must own the parent file
      allow read: if isAuthenticated() && ownsParentFile();

      // List/Query: User can query tables for their files
      allow list: if isAuthenticated();

      // Create: Backend only (tables created during file upload)
      // For now, allow if user owns the parent file
      allow create: if isAuthenticated()
                    && exists(/databases/$(database)/documents/parsed_excel_files/$(request.resource.data.parsed_file_id))
                    && get(/databases/$(database)/documents/parsed_excel_files/$(request.resource.data.parsed_file_id)).data.user_id == request.auth.uid;

      // Update: User must own parent file (for status updates, etc.)
      allow update: if isAuthenticated() && ownsParentFile();

      // Delete: User must own parent file (cascade delete)
      allow delete: if isAuthenticated() && ownsParentFile();
    }

    // Existing rules for other collections...
    // (Add your existing template, report, form rules here)
  }
}
